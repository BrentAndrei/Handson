# ---------------------------------------------------------------------------
# HandSon — Firebase Web SDK configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and paste in the values from the Firebase console:
#
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#   -> "SDK setup and configuration" -> Config
#
# The real `.env` is git-ignored and must never be committed.
#
# These values are Firebase WEB config, not secrets. The API key is designed to
# ship in a browser bundle; access is controlled by Authentication settings and
# authorised domains in the Firebase console. Never put a service-account key or
# the Firebase Admin SDK in this file or anywhere in this frontend.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
