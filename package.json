{
  "name": "handson",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:retarget": "tsx scripts/verify-retarget.ts",
    "verify:browser": "tsx scripts/verify-browser-pose.ts",
    "verify:root": "tsx scripts/verify-root-translation.ts",
    "verify:presentation": "tsx scripts/verify-presentation-layers.ts",
    "verify:footing": "tsx scripts/verify-footing.ts",
    "verify:zeroalloc": "tsx scripts/verify-zero-alloc.ts",
    "verify:live": "tsx scripts/verify-live-toggle.ts",
    "golden:capture": "tsx scripts/golden-snapshot.ts capture",
    "verify:golden": "tsx scripts/golden-snapshot.ts compare",
    "verify:parity": "tsx scripts/verify-smplx-parity.ts",
    "verify:adopt": "tsx scripts/verify-adopt-playback.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "verify:handedness": "tsx scripts/verify-mediapipe-handedness.ts",
    "verify:all": "npm run typecheck:src && npm run typecheck:scripts && npm run verify:contrast && npm run verify:retarget && npm run verify:root && npm run verify:golden && npm run build && npm run verify:ui",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "typecheck:src": "tsc --noEmit",
    "verify:ui": "tsx scripts/verify-ui-phase1.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.20",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.46",
    "framer-motion": "^13.4.0",
    "JSONStream": "^1.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stream-json": "^3.6.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
