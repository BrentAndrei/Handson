# ---------------------------------------------------------------------------
# HandSon — PLACEHOLDER Firebase config for the automated verification gates.
# ---------------------------------------------------------------------------
# COMMITTED ON PURPOSE, and safe to commit: these are not real credentials and
# are not connected to any Firebase project. They exist so `npm run verify:all`
# is deterministic on a machine with no Firebase project configured — the UI
# gate stubs the auth REST calls (scripts/firebase-test-backend.ts), so only
# the SHAPE of the config matters, never the values.
#
# A real developer config lives in `.env`, which Vite loads with higher
# priority and which IS git-ignored. Never put real values in this file.
#
# These are Firebase WEB config values, not secrets. Never add a service
# account key or the Admin SDK here.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=AIzaSyTESTKEY0000000000000000000000000
VITE_FIREBASE_AUTH_DOMAIN=handson-verify.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=handson-verify
VITE_FIREBASE_STORAGE_BUCKET=handson-verify.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
